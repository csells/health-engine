#!/usr/bin/env python3
"""Replay private lab data through public CLI seams without disclosing it."""

from __future__ import annotations

import csv
from decimal import Decimal, InvalidOperation
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from typing import Any


HEADERS = [
    "Date",
    "Test",
    "Value",
    "Units",
    "Reference Range",
    "Flag",
    "Source File",
]

SAFE_ERROR_CODES = {
    "analysis_provenance_mismatch",
    "canonical_test_mismatch",
    "cited_source_not_unique",
    "cli_failed",
    "clinical_time_mismatch",
    "empty_lab_source",
    "fact_count_mismatch",
    "fact_mismatch",
    "flag_mismatch",
    "idempotency_mismatch",
    "invalid_cli_output",
    "lab_name_mismatch",
    "lab_source_not_unique",
    "provenance_mismatch",
    "range_mismatch",
    "run_outside_private_root",
    "units_mismatch",
    "unsafe_source_alias",
    "unsafe_replay_name",
    "value_mismatch",
}


class ReplayError(Exception):
    pass


def read_json_lines(path: Path) -> list[dict[str, Any]]:
    with path.open(encoding="utf-8") as stream:
        return [json.loads(line) for line in stream if line.strip()]


def run_cli(
    binary: Path,
    workspace: Path,
    arguments: list[str],
    payload: dict[str, Any],
    log: Path,
) -> dict[str, Any]:
    process = subprocess.run(
        [str(binary), "--workspace", str(workspace), "--json", *arguments],
        input=json.dumps(payload, separators=(",", ":")),
        text=True,
        capture_output=True,
        check=False,
    )
    if process.returncode != 0:
        log.write_text(process.stderr, encoding="utf-8")
        log.chmod(0o600)
        raise ReplayError("cli_failed")
    try:
        return json.loads(process.stdout)
    except json.JSONDecodeError as error:
        raise ReplayError("invalid_cli_output") from error


def locate_lab_csv(tree: Path, inventory: list[dict[str, Any]]) -> Path:
    matches: list[Path] = []
    for item in inventory:
        if item["role"] != "machine_readable_source":
            continue
        path = tree / item["path"]
        if path.suffix.lower() != ".csv":
            continue
        try:
            with path.open(encoding="utf-8", newline="") as stream:
                if next(csv.reader(stream)) == HEADERS:
                    matches.append(path)
        except (OSError, StopIteration, UnicodeError, csv.Error):
            continue
    if len(matches) != 1:
        raise ReplayError("lab_source_not_unique")
    return matches[0]


def source_path(tree: Path, inventory: list[dict[str, Any]], alias: str) -> Path:
    relative = Path(alias)
    if relative.is_absolute() or ".." in relative.parts:
        raise ReplayError("unsafe_source_alias")
    direct = tree / relative
    if direct.is_file():
        return direct
    matches = [
        tree / item["path"]
        for item in inventory
        if item["kind"] == "file"
        and Path(item["path"]).name == relative.name
        and (tree / item["path"]).is_file()
    ]
    if len(matches) != 1:
        raise ReplayError("cited_source_not_unique")
    return matches[0]


def canonical_id(name: str) -> str:
    digest = hashlib.sha256(name.encode()).hexdigest()
    return f"legacy-lab-{digest}"


def validate_value(source: str, stored: dict[str, Any]) -> None:
    comparators = [("<=", "less_than_or_equal"), (">=", "greater_than_or_equal"),
                   ("<", "less_than"), (">", "greater_than")]
    for prefix, comparator in comparators:
        if source.startswith(prefix):
            if stored.get("type") != "qualified_numeric":
                raise ReplayError("value_mismatch")
            if stored.get("comparator") != comparator or stored.get("original") != source:
                raise ReplayError("value_mismatch")
            try:
                if Decimal(str(stored["value"])) != Decimal(source[len(prefix):]):
                    raise ReplayError("value_mismatch")
            except (InvalidOperation, KeyError) as error:
                raise ReplayError("value_mismatch") from error
            return
    try:
        expected = Decimal(source)
    except InvalidOperation:
        if stored != {"type": "text", "value": source}:
            raise ReplayError("value_mismatch")
        return
    if stored.get("type") != "numeric" or Decimal(str(stored.get("value"))) != expected:
        raise ReplayError("value_mismatch")


def verify_facts(
    rows: list[dict[str, str]],
    facts: list[dict[str, Any]],
    cited_ids: dict[str, str],
    parsed_id: str,
) -> None:
    by_region = {
        fact["evidence"]["parsed_region"]["locator"]: fact for fact in facts
    }
    if len(by_region) != len(rows):
        raise ReplayError("fact_count_mismatch")
    for index, row in enumerate(rows, 2):
        fact = by_region.get(f"row:{index}")
        if fact is None or fact.get("original_assurance") != "parser_validated":
            raise ReplayError("fact_mismatch")
        evidence = fact["evidence"]
        if evidence.get("parsed_source_id") != parsed_id:
            raise ReplayError("provenance_mismatch")
        if evidence.get("cited_source_id") != cited_ids[row["Source File"]]:
            raise ReplayError("provenance_mismatch")
        if fact["clinical_time"] != {"precision": "date", "value": row["Date"]}:
            raise ReplayError("clinical_time_mismatch")
        lab = fact["fact"]
        if lab["test_name"] != row["Test"]:
            raise ReplayError("lab_name_mismatch")
        canonical = lab.get("canonical_test")
        if canonical != {
            "identifier": canonical_id(row["Test"]),
            "display_name": row["Test"],
        }:
            raise ReplayError("canonical_test_mismatch")
        validate_value(row["Value"], lab["value"])
        if lab.get("units") != (row["Units"] or None):
            raise ReplayError("units_mismatch")
        source_range = row["Reference Range"] or None
        stored_range = lab.get("reference_range")
        if (stored_range and stored_range.get("original")) != source_range:
            raise ReplayError("range_mismatch")
        if lab.get("reported_flag") != (row["Flag"] or None):
            raise ReplayError("flag_mismatch")


def replay(config: dict[str, str]) -> None:
    repository = Path(__file__).resolve().parent.parent
    private_root = (repository / "tmp").resolve()
    run_root = Path(config["run_root"]).resolve(strict=True)
    binary = Path(config["binary"]).resolve(strict=True)
    if run_root == private_root or private_root not in run_root.parents:
        raise ReplayError("run_outside_private_root")
    tree = run_root / "sealed" / "tree"
    inventory = read_json_lines(run_root / "private" / "manifests" / "inventory.jsonl")
    lab_csv = locate_lab_csv(tree, inventory)
    with lab_csv.open(encoding="utf-8", newline="") as stream:
        rows = list(csv.DictReader(stream))
    if not rows:
        raise ReplayError("empty_lab_source")

    replay_name = config.get("replay_name", "labs-replay-v1")
    prefix = "labs-replay-v"
    if not replay_name.startswith(prefix) or not replay_name[len(prefix):].isdigit():
        raise ReplayError("unsafe_replay_name")
    replay_root = run_root / "private" / replay_name
    replay_root.mkdir(mode=0o700)
    logs = replay_root / "logs"
    logs.mkdir(mode=0o700)
    csv_alias = "migration/lab-timeline.csv"
    csv_target = replay_root / csv_alias
    csv_target.parent.mkdir(mode=0o700)
    shutil.copy2(lab_csv, csv_target)
    csv_target.chmod(0o600)
    for alias in sorted({row["Source File"] for row in rows}):
        target = replay_root / alias
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.copy2(source_path(tree, inventory, alias), target)
        target.chmod(0o600)

    init = run_cli(
        binary, replay_root, ["workspace", "init"],
        {"schema_version": 1, "subject_id": "migration-subject"},
        logs / "workspace-init.log",
    )
    cited_ids: dict[str, str] = {}
    for alias in sorted({row["Source File"] for row in rows}):
        status = run_cli(
            binary, replay_root, ["source", "register"],
            {"schema_version": 1, "alias": alias, "media_type": "application/pdf"},
            logs / "source-register.log",
        )
        cited_ids[alias] = status["source_id"]
    parsed = run_cli(
        binary, replay_root, ["source", "register"],
        {"schema_version": 1, "alias": csv_alias, "media_type": "text/csv"},
        logs / "timeline-register.log",
    )
    mappings = [
        {
            "reported_name": name,
            "canonical_test": {
                "identifier": canonical_id(name),
                "display_name": name,
            },
        }
        for name in sorted({row["Test"] for row in rows})
    ]
    request = {
        "schema_version": 1,
        "workspace_id": init["workspace_id"],
        "subject_id": init["subject_id"],
        "expected_revision": init["record_revision"],
        "idempotency_key": "private-labs-replay-v1",
        "source_id": parsed["source_id"],
        "asserted_by": {"kind": "application", "identifier": "migration-adapter"},
        "extractor": {"name": "health-engine-lab-timeline", "version": "1.0.0"},
        "test_mappings": mappings,
    }
    first = run_cli(
        binary, replay_root, ["record", "import-lab-timeline"], request,
        logs / "import.log",
    )
    second = run_cli(
        binary, replay_root, ["record", "import-lab-timeline"], request,
        logs / "import-retry.log",
    )
    if first != second:
        raise ReplayError("idempotency_mismatch")
    queried = run_cli(
        binary, replay_root, ["record", "query"],
        {"schema_version": 1, "query": {"kind": "lab_result", "include_history": False}},
        logs / "query.log",
    )
    verify_facts(rows, queried["facts"], cited_ids, parsed["source_id"])
    analysis = run_cli(
        binary, replay_root, ["analysis", "run"],
        {"schema_version": 1, "options": {"include_unverified": True}},
        logs / "analysis.log",
    )
    fact_ids = {fact["id"] for fact in queried["facts"]}
    if any(not set(claim["evidence_fact_ids"]).issubset(fact_ids)
           for claim in analysis["claims"]):
        raise ReplayError("analysis_provenance_mismatch")


def main() -> int:
    try:
        os.umask(0o077)
        replay(json.load(sys.stdin))
        print('{"status":"verified"}')
        return 0
    except ReplayError as error:
        code = str(error)
        if code not in SAFE_ERROR_CODES:
            code = "private_labs_replay_failed"
        print(json.dumps({"error": code}, separators=(",", ":")), file=sys.stderr)
        return 1
    except (KeyError, OSError, ValueError, csv.Error):
        print('{"error":"private_labs_replay_failed"}', file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
