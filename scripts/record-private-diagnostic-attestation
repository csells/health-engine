#!/usr/bin/env python3
"""Bind a private all-page visual review to protected diagnostic Sources."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


class AttestationError(Exception):
    pass


def read_json_lines(path: Path) -> list[dict[str, Any]]:
    with path.open(encoding="utf-8") as stream:
        return [json.loads(line) for line in stream if line.strip()]


def classify(text: str) -> str | None:
    lower = text.lower()
    if "final pathologic diagnosis" in lower and "materials received" in lower:
        return "pathology"
    if "findings:" in lower and "impression:" in lower and "mri" in lower:
        return "imaging"
    return None


def page_count(path: Path) -> int:
    process = subprocess.run(
        ["pdfinfo", str(path)], capture_output=True, text=True, check=False
    )
    if process.returncode != 0:
        raise AttestationError("pdfinfo_failed")
    match = re.search(r"^Pages:\s+(\d+)\s*$", process.stdout, re.MULTILINE)
    if not match:
        raise AttestationError("pdf_page_count_missing")
    return int(match.group(1))


def record(config: dict[str, str]) -> None:
    repository = Path(__file__).resolve().parent.parent
    private_root = (repository / "tmp").resolve()
    run_root = Path(config["run_root"]).resolve(strict=True)
    if run_root == private_root or private_root not in run_root.parents:
        raise AttestationError("run_outside_private_root")
    inventory = read_json_lines(run_root / "private" / "manifests" / "inventory.jsonl")
    manifest = {
        row["path"]: row
        for row in read_json_lines(run_root / "private" / "manifests" / "original-before.jsonl")
    }
    studies: list[dict[str, Any]] = []
    for item in inventory:
        if item.get("role") != "source" or not item.get("path", "").lower().endswith(".pdf"):
            continue
        source = run_root / "sealed" / "tree" / item["path"]
        process = subprocess.run(
            ["pdftotext", "-layout", str(source), "-"],
            capture_output=True,
            text=True,
            errors="ignore",
            check=False,
        )
        category = classify(process.stdout) if process.returncode == 0 else None
        if category:
            studies.append(
                {
                    "category": category,
                    "source_path": item["path"],
                    "sha256": manifest[item["path"]]["sha256"],
                    "reviewed_pages": page_count(source),
                }
            )
    if sorted(study["category"] for study in studies) != ["imaging", "pathology"]:
        raise AttestationError("diagnostic_sources_not_unique")
    document = {
        "schema_version": 1,
        "reviewer": config["reviewer"],
        "method": "rendered_page_review",
        "method_version": "1.0.0",
        "checked_at": config["checked_at"],
        "studies": sorted(studies, key=lambda study: study["category"]),
    }
    target = run_root / "private" / "diagnostic-source-verification.json"
    if target.exists():
        with target.open(encoding="utf-8") as stream:
            if json.load(stream) != document:
                raise AttestationError("diagnostic_attestation_conflict")
        return
    temporary = target.with_suffix(".tmp")
    with temporary.open("w", encoding="utf-8") as stream:
        json.dump(document, stream, sort_keys=True, separators=(",", ":"))
        stream.write("\n")
    temporary.chmod(0o600)
    temporary.replace(target)


def main() -> int:
    try:
        os.umask(0o077)
        record(json.load(sys.stdin))
        print('{"status":"recorded"}')
        return 0
    except (KeyError, OSError, ValueError, AttestationError):
        print('{"error":"diagnostic_attestation_failed"}', file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
